# Hammerspace SDK + Gratto chatbot configuration.
# Copy this file to .env (repo root) and fill in your values.
# ONE file serves everything: the Python SDK, the CLI bot, and the Gradio app.

# ---------------------------------------------------------------------------
# Hammerspace appliance (used by the SDK client and the chatbot cluster tools)
# ---------------------------------------------------------------------------
HS_BASE_URL=https://your-hammerspace-server:8443/mgmt/v1.2/rest
HS_USERNAME=your_username
HS_PASSWORD=your_password

# Security Settings
VERIFY_SSL=True

# Optional: Custom timeout settings (in seconds)
API_TIMEOUT=60
TASK_TIMEOUT=300

# ---------------------------------------------------------------------------
# LLM provider API keys (chatbot) — set only the one(s) you use.
# Pick a provider with: python chatbot/bot.py --provider <name>
# ---------------------------------------------------------------------------

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# Perplexity (perplexity.ai) — online models with web search
PERPLEXITY_API_KEY=

# Groq (console.groq.com) — fast open models
GROQ_API_KEY=

# Together AI (api.together.xyz)
TOGETHER_API_KEY=

# Mistral (console.mistral.ai)
MISTRAL_API_KEY=

# DeepSeek (platform.deepseek.com)
DEEPSEEK_API_KEY=

# OpenRouter (openrouter.ai) — gateway to many models
OPENROUTER_API_KEY=

# Ollama is local and needs no key; start it with `ollama serve`
# and pull a model with `ollama pull llama3.2`.

# Any other OpenAI-compatible endpoint:
# CUSTOM_LLM_BASE_URL=https://your-endpoint/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=your-model

# Optional fallback key for any provider:
# LLM_API_KEY=
